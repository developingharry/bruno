meta {
  name: Upgrade a cycle to the latest template version
  type: http
  seq: 33
}

post {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/upgrade
  body: none
  auth: inherit
}

params:path {
  @description('ID of the cycle to upgrade')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Upgrade a cycle to the latest template version**
  
  `POST /v1.0/Cycles/{id}/upgrade`
}
