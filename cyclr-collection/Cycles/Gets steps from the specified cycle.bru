meta {
  name: Gets steps from the specified cycle
  type: http
  seq: 15
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/steps
  body: none
  auth: inherit
}

params:query {
  @description('Filter by cycle step type')
  ~filter: None
}

params:path {
  @description('ID of the cycle to get the steps for')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets steps from the specified cycle**
  
  `GET /v1.0/Cycles/{id}/steps`
}
