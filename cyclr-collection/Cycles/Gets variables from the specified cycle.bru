meta {
  name: Gets variables from the specified cycle
  type: http
  seq: 26
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/variables
  body: none
  auth: inherit
}

params:path {
  @description('ID of the cycle to get the variables for')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets variables from the specified cycle**
  
  `GET /v1.0/Cycles/{id}/variables`
}
