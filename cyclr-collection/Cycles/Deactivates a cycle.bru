meta {
  name: Deactivates a cycle
  type: http
  seq: 14
}

put {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/deactivate
  body: none
  auth: inherit
}

params:query {
  @description('True if transactions in the queue should continue to be processed.')
  ~finishQueuedTransactions: false
}

params:path {
  @description('ID of the cycle to deactivate')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Deactivates a cycle**
  
  `PUT /v1.0/Cycles/{id}/deactivate`
}
