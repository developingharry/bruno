meta {
  name: Creates or updates a collection of variables
  type: http
  seq: 28
}

patch {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/variables
  body: json
  auth: inherit
}

params:path {
  @description('ID of the cycle to create or update the variables in')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  [
    {
      "DisplayName": "",
      "Value": "",
      "MappingType": "StaticValue"
    }
  ]
}

settings {
  encodeUrl: true
}

docs {
  **Creates or updates a collection of variables**
  
  `PATCH /v1.0/Cycles/{id}/variables`
}
