meta {
  name: Gets a step from the cycle
  type: http
  seq: 23
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/steps/:stepId
  body: none
  auth: inherit
}

params:path {
  @description('Id of the cycle')
  id: {{cyclr_cycleId}}
  @description('Id of the step in the cycle')
  stepId: {{cyclr_stepId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets a step from the cycle.**
  
  `GET /v1.0/Cycles/{id}/steps/{stepId}`
}
