meta {
  name: Creates a new delay step
  type: http
  seq: 19
}

post {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/steps/delay
  body: json
  auth: inherit
}

params:path {
  @description('Id of the cycle to create the delay step in.')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  {
    "Name": "",
    "Description": "",
    "ActionType": "None",
    "DisplayPositionLeft": 0,
    "DisplayPositionTop": 0,
    "LastSuccessfulRunDate": "2026-01-01T00:00:00Z",
    "Id": "00000000-0000-0000-0000-000000000000",
    "PreviousStepId": "00000000-0000-0000-0000-000000000000",
    "PreviousFieldId": 0,
    "CycleDelayUnit": "Seconds",
    "Interval": 0
  }
}

settings {
  encodeUrl: true
}

docs {
  **Creates a new delay step.**
  
  `POST /v1.0/Cycles/{id}/steps/delay`
}
