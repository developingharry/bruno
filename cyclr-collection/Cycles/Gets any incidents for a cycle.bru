meta {
  name: Gets any incidents for a cycle
  type: http
  seq: 10
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/incidents
  body: none
  auth: inherit
}

params:query {
  @description('Size of the page to get')
  ~pageSize: 10
  @description('The page to get')
  ~page: 1
  @description('True for ascending; false for descending')
  ~sortOrderAsc: true
  @description('Gets incidents that occurred on or after this timestamp')
  ~after: 
  @description('Gets incidents that occurred before or on this timestamp')
  ~before: 
}

params:path {
  @description('ID of the cycle')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets any incidents for a cycle**
  
  `GET /v1.0/Cycles/{id}/incidents`
}
