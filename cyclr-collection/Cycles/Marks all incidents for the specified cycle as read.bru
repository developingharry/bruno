meta {
  name: Marks all incidents for the specified cycle as read
  type: http
  seq: 11
}

delete {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/incidents
  body: none
  auth: inherit
}

params:path {
  @description('ID of the cycle')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Marks all incidents for the specified cycle as read**
  
  `DELETE /v1.0/Cycles/{id}/incidents`
}
