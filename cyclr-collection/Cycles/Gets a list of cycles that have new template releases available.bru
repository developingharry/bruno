meta {
  name: Gets a list of cycles that have new template releases available
  type: http
  seq: 34
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/upgradeable
  body: none
  auth: inherit
}

params:query {
  @description('Size of the page to get')
  ~pageSize: 10
  @description('The page to get')
  ~page: 1
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets a list of cycles that have new template releases available**
  
  `GET /v1.0/Cycles/upgradeable`
}
