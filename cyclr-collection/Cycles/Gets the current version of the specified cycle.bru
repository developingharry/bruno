meta {
  name: Gets the current version of the specified cycle
  type: http
  seq: 35
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Cycles/:id/currentversion
  body: none
  auth: inherit
}

params:path {
  @description('ID of a cycle that may have been replaced by a newer version.')
  id: {{cyclr_cycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets the current version of the specified cycle.**
  
  `GET /v1.0/Cycles/{id}/currentversion`
}
