meta {
  name: Exports a custom connector from an account
  type: http
  seq: 3
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/custom/:id
  body: none
  auth: inherit
}

params:path {
  @description('ID of the custom connector to export')
  id: {{cyclr_customConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Exports a custom connector from an account**
  
  `GET /v1.0/account/connectors/custom/{id}`
}
