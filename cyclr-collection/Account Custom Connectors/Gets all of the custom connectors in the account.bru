meta {
  name: Gets all of the custom connectors in the account
  type: http
  seq: 1
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/custom
  body: none
  auth: inherit
}

params:query {
  @description('Custom connector name search query')
  ~query: 
  @description('Page number')
  ~page: 1
  @description('Page size')
  ~pageSize: 10
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets all of the custom connectors in the account**
  
  `GET /v1.0/account/connectors/custom`
}
