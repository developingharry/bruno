meta {
  name: Gets the custom field by ID
  type: http
  seq: 3
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:accountConnectorId/fields/:id
  body: none
  auth: inherit
}

params:path {
  @description('Account connector ID')
  accountConnectorId: {{cyclr_accountConnectorId}}
  @description('Custom field ID')
  id: {{cyclr_customFieldId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets the custom field by ID**
  
  `GET /v1.0/account/connectors/{accountConnectorId}/fields/{id}`
}
