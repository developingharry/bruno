meta {
  name: Enable the specified MCP server
  type: http
  seq: 10
}

put {
  url: {{cyclr_baseUrl}}/v1.0/Mcp/servers/:id/enable
  body: none
  auth: inherit
}

params:path {
  @description('ID of the MCP server to enable.')
  id: {{cyclr_mcpServerId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Enable the specified MCP server.**
  
  `PUT /v1.0/Mcp/servers/{id}/enable`
}
