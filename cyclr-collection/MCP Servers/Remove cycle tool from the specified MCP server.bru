meta {
  name: Remove cycle tool from the specified MCP server
  type: http
  seq: 16
}

delete {
  url: {{cyclr_baseUrl}}/v1.0/Mcp/servers/:id/cycles/:versionedCycleId
  body: none
  auth: inherit
}

params:path {
  @description('ID of the MCP server to remove the tool from.')
  id: {{cyclr_mcpServerId}}
  @description('ID of the cycle to remove from the MCP server.')
  versionedCycleId: {{cyclr_versionedCycleId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Remove cycle tool from the specified MCP server.**
  
  `DELETE /v1.0/Mcp/servers/{id}/cycles/{versionedCycleId}`
}
