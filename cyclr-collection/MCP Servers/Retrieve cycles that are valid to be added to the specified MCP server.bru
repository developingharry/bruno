meta {
  name: Retrieve cycles that are valid to be added to the specified MCP server
  type: http
  seq: 14
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Mcp/servers/:id/cycles/valid
  body: none
  auth: inherit
}

params:path {
  @description('ID of the MCP server.')
  id: {{cyclr_mcpServerId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Retrieve cycles that are valid to be added to the specified MCP server.**
  
  `GET /v1.0/Mcp/servers/{id}/cycles/valid`
}
