meta {
  name: Replays the specified cycle transaction
  type: http
  seq: 3
}

put {
  url: {{cyclr_baseUrl}}/v1.0/cycles/:cycleId/transactions/:id/replay
  body: none
  auth: inherit
}

params:path {
  @description('ID of the cycle')
  cycleId: {{cyclr_cycleId}}
  @description('ID of the transaction to replay')
  id: {{cyclr_transactionId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Replays the specified cycle transaction**
  
  `PUT /v1.0/cycles/{cycleId}/transactions/{id}/replay`
}
