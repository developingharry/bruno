meta {
  name: Gets connectors
  type: http
  seq: 3
}

get {
  url: {{cyclr_baseUrl}}/v1.0/connectors/:name
  body: none
  auth: inherit
}

params:path {
  @description('Name of the connector')
  name: {{cyclr_connectorName}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets connectors**
  
  `GET /v1.0/connectors/{name}`
}
