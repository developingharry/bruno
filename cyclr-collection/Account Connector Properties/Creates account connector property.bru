meta {
  name: Creates account connector property
  type: http
  seq: 2
}

post {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:accountConnectorId/properties
  body: json
  auth: inherit
}

params:path {
  @description('Account connector ID')
  accountConnectorId: {{cyclr_accountConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  {
    "Name": "",
    "Value": "",
    "Id": 0
  }
}

settings {
  encodeUrl: true
}

docs {
  **Creates account connector property. If an account connector property with the same name already exists, it will get updated**
  
  `POST /v1.0/account/connectors/{accountConnectorId}/properties`
}
