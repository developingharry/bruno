meta {
  name: Updates account connector property
  type: http
  seq: 4
}

put {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:accountConnectorId/properties/:id
  body: json
  auth: inherit
}

params:path {
  @description('Account connector ID')
  accountConnectorId: {{cyclr_accountConnectorId}}
  @description('Account connector property ID')
  id: {{cyclr_accountConnectorPropertyId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  {
    "Name": "",
    "Value": "",
    "Id": 0
  }
}

settings {
  encodeUrl: true
}

docs {
  **Updates account connector property**
  
  `PUT /v1.0/account/connectors/{accountConnectorId}/properties/{id}`
}
