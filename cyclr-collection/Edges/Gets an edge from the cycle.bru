meta {
  name: Gets an edge from the cycle
  type: http
  seq: 3
}

get {
  url: {{cyclr_baseUrl}}/v1.0/cycles/:cycleId/edges/:id
  body: none
  auth: inherit
}

params:path {
  @description('ID of the cycle')
  cycleId: {{cyclr_cycleId}}
  @description('ID of the edge')
  id: {{cyclr_edgeId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets an edge from the cycle**
  
  `GET /v1.0/cycles/{cycleId}/edges/{id}`
}
