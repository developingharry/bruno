meta {
  name: Removes a user from the specified account
  type: http
  seq: 3
}

delete {
  url: {{cyclr_baseUrl}}/v1.0/accounts/:accountId/users
  body: json
  auth: inherit
}

params:path {
  @description('Id of the account to remove the user from')
  accountId: {{cyclr_accountId}}
}

body:json {
  {
    "UserName": ""
  }
}

settings {
  encodeUrl: true
}

docs {
  **Removes a user from the specified account**
  
