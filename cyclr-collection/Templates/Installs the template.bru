meta {
  name: Installs the template
  type: http
  seq: 5
}

post {
  url: {{cyclr_baseUrl}}/v1.0/Templates/:id/install
  body: json
  auth: inherit
}

params:query {
  @description('If true response will contain connector icons')
  ~includeIcons: false
  @description('If true, the response will contain mapping prerequisites')
  ~includePrerequisites: false
}

params:path {
  @description('ID of the template to install')
  id: {{cyclr_templateId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

