meta {
  name: Generate an account connector setup link
  type: http
  seq: 16
}

post {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:id/getsetuplink
  body: json
  auth: inherit
}

params:path {
  @description('Account connector ID')
  id: {{cyclr_accountConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  {
    "Username": "",
    "Expiry": 0
  }
}

settings {
  encodeUrl: true
}

docs {
  **Generate an account connector setup link**
  
  `POST /v1.0/account/connectors/{id}/getsetuplink`
}
