meta {
  name: De-authenticates account connector
  type: http
  seq: 8
}

put {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:id/deauthenticate
  body: none
  auth: inherit
}

params:path {
  @description('ID of the account connector to be de-authenticated')
  id: {{cyclr_accountConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **De-authenticates account connector**
  
  `PUT /v1.0/account/connectors/{id}/deauthenticate`
}
