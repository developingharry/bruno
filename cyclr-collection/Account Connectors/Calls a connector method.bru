meta {
  name: Calls a connector method
  type: http
  seq: 10
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:id/methods/:methodId
  body: none
  auth: inherit
}

params:path {
  @description('Account connector ID')
  id: {{cyclr_accountConnectorId}}
  @description('Method ID or the method unique identifier')
  methodId: {{cyclr_accountConnectorMethodId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Calls a connector method**
  
  `GET /v1.0/account/connectors/{id}/methods/{methodId}`
}
