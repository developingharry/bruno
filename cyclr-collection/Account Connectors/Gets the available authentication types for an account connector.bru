meta {
  name: Gets the available authentication types for an account connector
  type: http
  seq: 6
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:id/authenticationtypes
  body: none
  auth: inherit
}

params:path {
  @description('Account connector ID')
  id: {{cyclr_accountConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets the available authentication types for an account connector**
  
  `GET /v1.0/account/connectors/{id}/authenticationtypes`
}
