meta {
  name: Delete a specific created custom category
  type: http
  seq: 4
}

delete {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:accountConnectorId/customcategories/:customCategoryId
  body: none
  auth: inherit
}

params:path {
  @description('Account connector ID')
  accountConnectorId: {{cyclr_accountConnectorId}}
  @description('Custom category ID')
  customCategoryId: {{cyclr_customCategoryId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Delete a specific created custom category**
  
  `DELETE /v1.0/account/connectors/{accountConnectorId}/customcategories/{customCategoryId}`
}
