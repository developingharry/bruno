meta {
  name: List all created custom categories
  type: http
  seq: 1
}

get {
  url: {{cyclr_baseUrl}}/v1.0/account/connectors/:accountConnectorId/customcategories
  body: none
  auth: inherit
}

params:path {
  @description('Account connector ID')
  accountConnectorId: {{cyclr_accountConnectorId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **List all created custom categories**
  
  `GET /v1.0/account/connectors/{accountConnectorId}/customcategories`
}
