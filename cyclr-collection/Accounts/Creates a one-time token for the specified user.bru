meta {
  name: Creates a one-time token for the specified user
  type: http
  seq: 2
}

post {
  url: {{cyclr_baseUrl}}/v1.0/accounts/:id/signintoken
  body: json
  auth: inherit
}

params:path {
  id: {{cyclr_accountId}}
}

body:json {
  {
    "Username": ""
  }
}

settings {
  encodeUrl: true
}

docs {
  **Creates a one-time token for the specified user. The user will be created if they do not currently exist**
  
  `POST /v1.0/accounts/{id}/signintoken`
}
