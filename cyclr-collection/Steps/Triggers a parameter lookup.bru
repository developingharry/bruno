meta {
  name: Triggers a parameter lookup
  type: http
  seq: 11
}

post {
  url: {{cyclr_baseUrl}}/v1.0/Steps/:id/parameters/:parameterId/lookup
  body: json
  auth: inherit
}

params:path {
  @description('ID of the step to trigger the parameter lookup for')
  id: {{cyclr_stepId}}
  @description('Parameter ID')
  parameterId: {{cyclr_parameterId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

body:json {
  {
    "TriggerId": 0,
    "TriggerParameters": {},
    "TriggerFieldMappings": {}
  }
}

settings {
  encodeUrl: true
}

docs {
  **Triggers a parameter lookup**
  
  `POST /v1.0/Steps/{id}/parameters/{parameterId}/lookup`
}
