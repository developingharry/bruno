meta {
  name: Gets fields from previous steps that can be used in field mapping
  type: http
  seq: 2
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Steps/:id/fieldsformapping
  body: none
  auth: inherit
}

params:path {
  @description('Id of the step to get previous field mappings for')
  id: {{cyclr_stepId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets fields from previous steps that can be used in field mapping**
  
  `GET /v1.0/Steps/{id}/fieldsformapping`
}
