meta {
  name: Gets a method by ID
  type: http
  seq: 1
}

get {
  url: {{cyclr_baseUrl}}/v1.0/Methods/:id
  body: none
  auth: inherit
}

params:path {
  @description('ID of the method to get')
  id: {{cyclr_methodId}}
}

headers {
  @description("For calls to Cyclr API endpoints that relate to an account, you need to provide the account's <code>{API ID}</code> as an HTTP header in the request: <code>X-Cyclr-Account: {API_ID}</code>.")
  X-Cyclr-Account: {{cyclr_accountId}}
}

settings {
  encodeUrl: true
}

docs {
  **Gets a method by ID**
  
  `GET /v1.0/Methods/{id}`
}
